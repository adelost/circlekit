{
  "name": "@v1d/web-kit",
  "version": "0.8.0",
  "description": "Cutkit's kit for web pages: the tokens and the parts Huset and the API's sandbox draw with, built from Cutkit's one source",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./web-kit.css": "./dist/web-kit.css",
    "./timeview.css": "./dist/timeview.css",
    "./timescale": {
      "types": "./dist/timescale.d.ts",
      "default": "./dist/timescale.js"
    },
    "./timeview": {
      "types": "./dist/timeview.d.ts",
      "default": "./dist/timeview.js"
    },
    "./songrow": {
      "types": "./dist/songrow.d.ts",
      "default": "./dist/songrow.js"
    },
    "./songwave": {
      "types": "./dist/songwave.d.ts",
      "default": "./dist/songwave.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "default": "./dist/tokens.js"
    },
    "./encode": {
      "types": "./dist/kit/encode.d.ts",
      "default": "./dist/kit/encode.js"
    },
    "./file_identity": {
      "types": "./dist/kit/file_identity.d.ts",
      "default": "./dist/kit/file_identity.js"
    },
    "./picture_curve": {
      "types": "./dist/core/picture_curve.d.ts",
      "default": "./dist/core/picture_curve.js"
    },
    "./chapter_candidates": {
      "types": "./dist/core/chapter_candidates.d.ts",
      "default": "./dist/core/chapter_candidates.js"
    },
    "./chapter_sheet_layout": {
      "types": "./dist/core/chapter_sheet_layout.d.ts",
      "default": "./dist/core/chapter_sheet_layout.js"
    },
    "./chapter_plan": {
      "types": "./dist/core/chapter_plan.d.ts",
      "default": "./dist/core/chapter_plan.js"
    },
    "./preview_curve_tap": {
      "types": "./dist/preview_curve_tap.d.ts",
      "default": "./dist/preview_curve_tap.js"
    },
    "./song_data": {
      "types": "./dist/kit/song_data.d.ts",
      "default": "./dist/kit/song_data.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "check": "node scripts/check-dist.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED"
}
