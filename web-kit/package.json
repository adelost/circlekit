{
  "name": "@v1d/web-kit",
  "version": "0.2.0",
  "description": "Cutkit's kit for web pages: the tokens and the parts Huset and the API's sandbox draw with, built from Cutkit's one source",
  "type": "module",
  "main": "./dist/index.js",
