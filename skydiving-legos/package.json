{
  "name": "@v1d/skydiving-legos",
  "version": "0.1.17",
  "description": "The skydiving domain as a reserved ProductSpec library catalog: contracts, node types and finite spaces",
  "type": "module",
  "files": [
    "dist/src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./wire": {
      "types": "./dist/src/wire/index.d.ts",
      "import": "./dist/src/wire/index.js"
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "check:pins": "node ../scripts/check-peer-product-spec.mjs . '>=0.3.92 <0.4.0'",
    "pack:release": "npm run test && npm pack"
  },
  "peerDependencies": {
    "@v1d/product-spec": ">=0.3.92 <0.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@v1d/product-spec": "https://circlekit.pages.dev/npm/v1d/product-spec/0.3.92/v1d-product-spec-0.3.92.tgz",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED"
}
