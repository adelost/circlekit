{
  "name": "@v1d/api-client",
  "version": "0.12.16",
  "description": "What the v1d API runs on the person's own device: waveform, encode, cuts and the files store's start and register bodies (WebCodecs and mediabunny), built from the ai-gateway repository's one source",
  "type": "module",
  "main": "./dist/device/index.js",
  "module": "./dist/device/index.js",
  "types": "./dist/device/index.d.ts",
  "files": [
    "dist",
    "bench/quick",
    "README.md"
  ],
  "exports": {
    "./modal-proof": "./dist/modal-proof/modal-serialization.mjs",
    "./modal-proof/index-sdk-files": "./dist/modal-proof/index-sdk-files.mjs",
    "./device": {
      "types": "./dist/device/index.d.ts",
      "default": "./dist/device/index.js"
    },
    "./profile": {
      "types": "./dist/device/profile.d.ts",
      "default": "./dist/device/profile.js"
    },
    "./upload": {
      "types": "./dist/device/upload.d.ts",
      "default": "./dist/device/upload.js"
    },
    "./cuts": {
      "types": "./dist/device/cuts-index.d.ts",
      "default": "./dist/device/cuts-index.js"
    },
    "./quick": {
      "types": "./dist/device/quick-index.d.ts",
      "default": "./dist/device/quick-index.js"
    },
    "./quick-score": {
      "types": "./dist/device/quick-score.d.ts",
      "default": "./dist/device/quick-score.js"
    },
    "./reframe": {
      "types": "./dist/device/reframe-index.d.ts",
      "default": "./dist/device/reframe-index.js"
    },
    "./package.json": "./package.json",
    "./media": {
      "types": "./dist/device/media-bodies.d.ts",
      "default": "./dist/device/media-bodies.js"
    },
    "./rank-facit": {
      "types": "./dist/device/rank-facit.d.ts",
      "default": "./dist/device/rank-facit.js"
    },
    "./vision": {
      "types": "./dist/device/vision-index.d.ts",
      "default": "./dist/device/vision-index.js"
    },
    "./stored": {
      "types": "./dist/device/stored.d.ts",
      "default": "./dist/device/stored.js"
    },
    "./input": {
      "types": "./dist/device/input.d.ts",
      "default": "./dist/device/input.js"
    },
    "./errors": {
      "types": "./dist/device/errors.d.ts",
      "default": "./dist/device/errors.js"
    }
  },
  "dependencies": {
    "mediabunny": "1.61.6"
  },
  "scripts": {
    "check": "node scripts/check-dist.mjs"
  },
  "license": "UNLICENSED"
}
