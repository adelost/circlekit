{
  "name": "@v1d/product-spec",
  "version": "0.3.50",
  "description": "Product-neutral typed authoring and compiler core for v1d applications",
  "type": "module",
  "files": [
    "dist/src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./foundation": {
      "types": "./dist/src/foundation.d.ts",
      "import": "./dist/src/foundation.js"
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "pack:release": "npm run test && npm pack"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED"
}
