{
  "name": "@v1d/circlekit-assets",
  "version": "0.3.25",
  "description": "Portable immutable CircleKit asset catalog",
  "type": "module",
  "files": [
    "dist/src"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "generate:designkit": "npm run build && node scripts/generate-ring-icons.mjs",
    "check:designkit": "npm run build && node scripts/generate-ring-icons.mjs --check",
    "pack:release": "npm run check:designkit && npm pack"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED"
}
