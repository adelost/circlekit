{
  "name": "@v1d/skydiving-legos",
  "version": "0.1.0",
  "description": "The skydiving domain as a reserved ProductSpec library catalog: contracts, node types and finite spaces",
  "type": "module",
  "files": [
    "dist/src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "check:pins": "node node_modules/@v1d/product-spec/dist/src/pin-check-cli.js",
    "pack:release": "npm run test && npm pack"
  },
  "dependencies": {
    "@v1d/product-spec": "https://circlekit.pages.dev/npm/v1d/product-spec/0.3.51/v1d-product-spec-0.3.51.tgz"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED"
}
