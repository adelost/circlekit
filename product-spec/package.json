{
  "name": "@v1d/product-spec",
  "version": "0.3.76",
  "description": "Product-neutral typed authoring and compiler core for v1d applications",
  "type": "module",
  "files": [
    "dist/src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "v1d-observe": "./dist/src/observed.js",
      "studio-trace": "./dist/src/studio-trace.js",
      "import": "./dist/src/index.js"
    },
    "./foundation": {
      "types": "./dist/src/foundation.d.ts",
      "import": "./dist/src/foundation.js"
    },
    "./node": {
      "types": "./dist/src/node.d.ts",
      "import": "./dist/src/node.js"
    },
    "./observation": {
      "types": "./dist/src/observation.d.ts",
      "import": "./dist/src/observation.js"
    },
    "./examples/vision-box": {
      "types": "./dist/src/examples/vision-box.d.ts",
      "import": "./dist/src/examples/vision-box.js"
    },
    "./browser": {
      "types": "./dist/src/browser-observation.d.ts",
      "import": "./dist/src/browser-observation.js"
    },
    "./vite": {
      "types": "./dist/src/vite-plugin.d.ts",
      "import": "./dist/src/vite-plugin.js"
    }
  },
  "bin": {
    "v1d-check-pins": "./dist/src/pin-check-cli.js"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "npm run build && node --enable-source-maps --test dist/test/*.test.js",
    "check:pins": "npm run build && node dist/src/pin-check-cli.js",
    "pack:release": "npm run test && npm pack"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED"
}
