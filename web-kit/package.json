{
  "name": "@v1d/web-kit",
  "version": "0.34.0",
  "description": "Cutkit's kit for web pages: the tokens and the parts Huset and the API's sandbox draw with, built from Cutkit's one source",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./web-kit.css": "./dist/web-kit.css",
    "./timeview.css": "./dist/timeview.css",
    "./timescale": {
      "types": "./dist/timescale.d.ts",
      "default": "./dist/timescale.js"
    },
    "./timeview": {
      "types": "./dist/timeview.d.ts",
      "default": "./dist/timeview.js"
    },
    "./songrow": {
      "types": "./dist/songrow.d.ts",
      "default": "./dist/songrow.js"
    },
    "./wordrow": {
      "types": "./dist/wordrow.d.ts",
      "default": "./dist/wordrow.js"
    },
    "./spanrow": {
      "types": "./dist/spanrow.d.ts",
      "default": "./dist/spanrow.js"
    },
    "./fragment-player": {
      "default": "./dist/fragment-player.js"
    },
    "./fragment-feed": {
      "default": "./dist/fragment-feed.js"
    },
    "./fragment-store": {
      "default": "./dist/fragment-store.js"
    },
    "./songwave": {
      "types": "./dist/songwave.d.ts",
      "default": "./dist/songwave.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "default": "./dist/tokens.js"
    },
    "./file_identity": {
      "types": "./dist/kit/file_identity.d.ts",
      "default": "./dist/kit/file_identity.js"
    },
    "./song_data": {
      "types": "./dist/kit/song_data.d.ts",
      "default": "./dist/kit/song_data.js"
    },
    "./mark": {
      "types": "./dist/mark.d.ts",
      "default": "./dist/mark.js"
    },
    "./fonts/*": "./dist/fonts/*",
    "./icons/*": "./dist/icons/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "check": "node scripts/check-dist.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED"
}
